// The executable's resources: what Explorer, the taskbar and the Properties dialog read.
//
// app.ico is generated from ui_gtk/data/io.github.fwilhe2.Quill.svg, the one source of the
// mark (`magick -background none <svg> -define icon:auto-resize=256,64,48,32,16 app.ico`).
//
// Names are spelled as numbers because this file includes no headers, so `rc.exe` needs
// nothing but this directory: `1 24` is CREATEPROCESS_MANIFEST_RESOURCE_ID / RT_MANIFEST, and
// the version block's name is the literal `1`. `VS_VERSION_INFO` would be a *string* name
// without `winver.h`, which compiles, links, and is never found by GetFileVersionInfo —
// measured in grind, where every Properties field came back empty from a resource that was
// demonstrably in the binary.
1 ICON "app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Florian Wilhelm"
            VALUE "FileDescription",  "Quill - a shared core with native shells"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "quill-win32"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Florian Wilhelm"
            VALUE "OriginalFilename", "quill-win32.exe"
            VALUE "ProductName",      "Quill"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
