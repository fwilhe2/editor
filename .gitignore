/target
**/*.rs.bk
*.session.json
.claude/settings.local.json

# Generated by the uniffi bindings generators at build time; never edited by hand.
ui_windows/Generated/
ui_mac/Sources/EditorCore/editor_ffi.swift
ui_mac/Sources/EditorFFI/include/editor_ffiFFI.h

# SwiftPM build output
ui_mac/.build/

# The browser shell's assembled page (wasm + generated glue + the copied static
# files), the node-target glue the smoke test drives, and jsdom itself.
ui_web/dist/
ui_web/.smoke/
ui_web/node_modules/

# .NET build output. Scoped to the C# projects: an unanchored `bin/` would also
# swallow Rust's src/bin/ directories.
ui_windows/[Bb]in/
ui_windows/[Oo]bj/
ffi/csharp-smoke/[Bb]in/
ffi/csharp-smoke/[Oo]bj/
