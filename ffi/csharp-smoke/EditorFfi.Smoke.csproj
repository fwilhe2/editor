<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exercises the UniFFI boundary from C# without any UI. It runs on Linux as well
    as Windows, which is what makes the FFI layer testable on a machine that has no
    Windows: the same generated bindings load libeditor_ffi.so here and
    editor_ffi.dll there.

    The generated bindings declare their types `internal`, so they have to be
    compiled into this assembly rather than referenced from another one.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EditorFfi.Smoke</RootNamespace>
    <AssemblyName>EditorFfi.Smoke</AssemblyName>
    <!-- Generated bindings live outside this directory, so pick files explicitly. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GeneratedBindings>$(MSBuildThisFileDirectory)..\..\ui_windows\Generated\editor_ffi.cs</GeneratedBindings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(GeneratedBindings)" />
  </ItemGroup>

</Project>
