/target
# A container build needs its own CARGO_TARGET_DIR, or two toolchains fight over
# the same fingerprints; see doc/shared-core-native-shell.md.
/target-container
**/*.rs.bk
*.session.json
.claude/settings.local.json

# Generated by the uniffi bindings generator at build time; never edited by hand.
ui_mac/Sources/EditorCore/editor_ffi.swift
ui_mac/Sources/EditorFFI/include/editor_ffiFFI.h

# SwiftPM build output
ui_mac/.build/

# The browser shell's assembled page (wasm + generated glue + the copied static
# files), the node-target glue the smoke test drives, and jsdom itself.
ui_web/dist/
ui_web/.smoke/
ui_web/node_modules/
