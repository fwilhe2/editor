<Window
    x:Class="EditorApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                x:Name="SaveButton"
                Click="OnSave"
                Icon="Save"
                Label="Save">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="UndoButton"
                Click="OnUndo"
                Icon="Undo"
                Label="Undo">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Z" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="RedoButton"
                Click="OnRedo"
                Icon="Redo"
                Label="Redo">
                <AppBarButton.KeyboardAccelerators>
                    <!-- Ctrl+Y is the Windows convention; Ctrl+Shift+Z is accepted too. -->
                    <KeyboardAccelerator Key="Y" Modifiers="Control" />
                    <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <!--
            Read-only on purpose: the core owns the document, and this control only
            renders the current viewport. Keys are intercepted and forwarded instead
            of being allowed to edit the TextBox.
        -->
        <TextBox
            x:Name="TextArea"
            Grid.Row="1"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            CharacterReceived="OnCharacterReceived"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="14"
            IsReadOnly="True"
            IsSpellCheckEnabled="False"
            KeyDown="OnKeyDown"
            TextWrapping="NoWrap" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="12,4,12,8"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Window>
